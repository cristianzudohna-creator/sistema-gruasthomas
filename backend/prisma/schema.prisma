// ✅ Archivo: prisma/schema.prisma (COMPLETO)
// ✅ NUEVO:
// - PasswordResetRequest para recuperación por RUT + código
// - relación inversa en User: passwordResetRequests
// - módulo base de Incidentes + Taller + Repuestos usados
// - WorkshopTaskAssignment para múltiples personas en una tarea
// - WorkshopTask.codigo único
// - WorkerType incluye ADQUISICIONES
// - WorkshopTaskStatus incluye EN_COMPRA, COMPRADO, ENTREGADO
// ✅ pensado para funcionar en local y producción
//
// ✅ NUEVO AHORA:
// - WorkshopExtraHourStatus
// - WorkshopExtraHourReport
// - relación en User para reportes de horas extras creados
// - relación en User para reportes firmados por JEFE_TALLER
// ✅ FIX NUEVO:
// - VehicleIncident.fotoUrl para guardar evidencia/foto del incidente

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  CONTROL_FLOTA
  ADMINISTRADORA
  TRABAJADOR
}

enum AuditEntity {
  USER
  VEHICLE
  DOCUMENT
  MAINTENANCE
  WORK_ORDER
  HOROMETER
  CLIENT

  VEHICLE_INCIDENT
  WORKSHOP_TASK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TOGGLE
  LOGIN
  RESTORE
}

enum VehicleType {
  CAMION
  AUTO
  CAMIONETA
}

enum DocumentType {
  SOAP
  REVISION_TECNICA
  PERMISO_CIRCULACION
  SEGURO
  OTRO
}

enum MaintenanceType {
  CAMBIO_ACEITE
  CAMBIO_FILTROS
  FRENOS
  NEUMATICOS
  BATERIA
  ALINEACION_BALANCEO
  OTRO
}

enum Empresa {
  GRUAS_THOMAS
  INSPROTEL
}

/**
 * ✅ estado operativo del vehículo
 * - OPERATIVO: sí debe generar alertas
 * - EN_PANA / PARADO: NO debe generar alertas
 */
enum VehicleOperationalStatus {
  OPERATIVO
  EN_PANA
  PARADO
}

enum WorkerType {
  CONDUCTOR
  RIGGER
  OPERADOR
  MECANICO
  JEFE_TALLER

  ADMINISTRACION
  ADQUISICIONES
  ASEO
  AYUDANTE_DE_MECANICO
  CASA_PARTICULAR
  LAVADOR_EQUIPOS
  MECANICO_HIDRAULICO
  NOCHERO
  PREVENCION
  SOLDADOR
  SUPERVISOR

  OTRO
}

// =========================
// ✅ INCIDENTES / TALLER
// =========================

enum VehicleIncidentType {
  PINCHAZO
  PANE_MECANICA
  FALLA_HIDRAULICA
  FALLA_ELECTRICA
  SOBRECALENTAMIENTO
  FUGA
  ACCIDENTE
  OTRO
}

enum VehicleIncidentSeverity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum VehicleIncidentStatus {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
  CANCELADO
}

enum WorkshopTaskStatus {
  PENDIENTE
  EN_REVISION
  EN_REPARACION
  ESPERANDO_REPUESTO
  EN_COMPRA
  COMPRADO
  ENTREGADO
  TERMINADA
  CANCELADA
}

enum WorkshopTaskPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// ✅ NUEVO: múltiples personas por tarea
enum WorkshopTaskAssignmentRole {
  RESPONSABLE
  APOYO
}

// =========================
// ✅ HORAS EXTRAS TALLER
// =========================

enum WorkshopExtraHourStatus {
  BORRADOR
  ENVIADO
  FIRMADO
  RECHAZADO
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  nombre   String
  apellido String
  rut      String? @unique
  role     Role    @default(TRABAJADOR)
  activo   Boolean @default(true)
  fcmToken String?

  mustChangePassword Boolean   @default(false)
  passwordResetAt    DateTime?

  empresa    Empresa?
  workerType WorkerType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens      PasswordResetToken[]
  passwordResetRequests    PasswordResetRequest[]
  auditLogs                AuditLog[]

  horometers HorometerRecord[] @relation("UserHorometers")

  workOrdersCreated   WorkOrder[]         @relation("WorkOrderCreatedBy")
  workOrdersAssigned  WorkOrder[]         @relation("WorkOrderAssignedTo")
  workOrdersCompleted WorkOrder[]         @relation("WorkOrderCompletedBy")
  workOrdersApproved  WorkOrder[]         @relation("WorkOrderApprovedBy")
  workOrderEvidences  WorkOrderEvidence[]

  reportedIncidents       VehicleIncident[]         @relation("VehicleIncidentReportedBy")
  workshopTasksCreated    WorkshopTask[]            @relation("WorkshopTaskCreatedBy")
  workshopTasksAssigned   WorkshopTask[]            @relation("WorkshopTaskAssignedTo")
  workshopTasksClosed     WorkshopTask[]            @relation("WorkshopTaskClosedBy")
  workshopTaskAssignments WorkshopTaskAssignment[]

  extraHourReports       WorkshopExtraHourReport[] @relation("WorkshopExtraHourTrabajador")
  signedExtraHourReports WorkshopExtraHourReport[] @relation("WorkshopExtraHourSignedBy")

  @@index([empresa])
  @@index([workerType])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  userId    String
  rut       String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rut])
  @@index([code])
  @@index([expiresAt])
  @@index([createdAt])
}

model AuditLog {
  id       String      @id @default(uuid())
  entity   AuditEntity
  entityId String
  action   AuditAction

  actorId    String?
  actorEmail String?

  ip        String?
  userAgent String?

  data      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([actorEmail])
  @@index([createdAt])
  @@index([entity, createdAt])
  @@index([action, createdAt])
  @@index([entity, action, createdAt])
}

model Vehicle {
  id          String  @id @default(uuid())
  patente     String  @unique
  marcaModelo String
  conductor   String?

  type         VehicleType
  tipoVehiculo String?
  year         Int?

  empresa Empresa @default(GRUAS_THOMAS)

  estadoOperativo VehicleOperationalStatus @default(OPERATIVO)

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    VehicleDocument[]
  maintenances VehicleMaintenance[]

  horometers    HorometerRecord[]
  horometerPlan HorometerMaintenancePlan?
  workOrders    WorkOrder[]

  incidents     VehicleIncident[]
  workshopTasks WorkshopTask[]

  @@index([empresa])
  @@index([estadoOperativo])
  @@index([activo])
}

model VehicleDocument {
  id               String       @id @default(uuid())
  vehicleId        String
  type             DocumentType
  nombre           String?
  fechaVencimiento DateTime?
  observacion      String?
  archivoUrl       String?

  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@index([fechaVencimiento])
}

model VehicleMaintenance {
  id             String          @id @default(uuid())
  vehicleId      String
  type           MaintenanceType
  nombre         String?
  fechaRealizada DateTime
  fechaProxima   DateTime?
  observacion    String?
  archivoUrl     String?

  filePath     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@index([fechaProxima])
}

model HorometerRecord {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  trabajadorId String
  trabajador   User   @relation("UserHorometers", fields: [trabajadorId], references: [id], onDelete: Restrict)

  trabajadorNombre   String
  trabajadorApellido String
  trabajadorRut      String?
  trabajadorEmail    String

  empresa Empresa

  horas      Int
  comentario String?

  fotoUrl      String
  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([trabajadorId])
  @@index([empresa])
  @@index([createdAt])
}

model CompanySettings {
  id      String  @id @default(uuid())
  empresa Empresa @unique

  nombre        String
  emailContacto String?
  telefono      String?
  direccion     String?
  logoUrl       String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// =========================
// CLIENTES
// =========================

model Client {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  nombre String
  rut    String?

  giro      String?
  telefono  String?
  direccion String?
  comuna    String?
  ciudad    String?

  workOrders WorkOrder[]

  @@unique([empresa, rut], name: "client_empresa_rut_unique")
  @@index([empresa])
  @@index([nombre])
}

// =========================
// ORDENES DE TRABAJO
// =========================

enum WorkOrderStatus {
  ABIERTA
  EN_PROCESO
  COMPLETADA
  APROBADA
  RECHAZADA
  CERRADA
}

enum WorkOrderPriority {
  BAJA
  MEDIA
  ALTA
}

enum WorkOrderType {
  MANTENCION
  REPARACION
  DOCUMENTO
  OTRO
}

model WorkOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa           @default(GRUAS_THOMAS)
  status   WorkOrderStatus   @default(ABIERTA)
  priority WorkOrderPriority @default(MEDIA)
  type     WorkOrderType     @default(OTRO)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  cliente       String?
  rut           String?
  giro          String?
  solicitadoPor String?
  direccion     String?
  comuna        String?
  ciudad        String?

  telefonoCliente String?
  direccionFaena  String?

  lugar    String?
  horario  String?
  mapsLink String?

  camion    String?
  conductor String?
  operador  String?
  rigger    String?
  sinJib    Boolean @default(false)

  diasTrabajo     String[] @default([])
  diasProgramados String[] @default([])

  nota String?

  titulo      String?
  descripcion String?

  fechaProgramada DateTime?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User? @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  startedAt       DateTime?
  finishedAt      DateTime?
  horasTrabajo    Int?
  comentarioFinal String?

  workerReport  Json?
  completedAt   DateTime?
  completedById String?
  completedBy   User? @relation("WorkOrderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User? @relation("WorkOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalComment String?
  rejectReason    String?

  items     WorkOrderItem[]
  evidences WorkOrderEvidence[]

  activo    Boolean   @default(true)
  deletedAt DateTime?

  @@index([empresa])
  @@index([status])
  @@index([assignedToId])
  @@index([vehicleId])
  @@index([completedAt])
  @@index([completedById])
  @@index([approvedAt])
  @@index([approvedById])
  @@index([clientId])
  @@index([activo])
  @@index([empresa, activo])
  @@index([deletedAt])
}

model WorkOrderItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  titulo      String
  obligatorio Boolean @default(false)

  done   Boolean   @default(false)
  doneAt DateTime?

  @@index([workOrderId])
}

model WorkOrderEvidence {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileUrl      String
  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  @@index([workOrderId])
  @@index([uploadedById])
}

enum AlertKind {
  DOCUMENT
  MAINTENANCE
  HOROMETER
}

model AlertDispatchLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  kind          AlertKind
  entityId      String
  thresholdDays Int

  recipient String?
  subject   String?
  messageId String?

  @@unique([kind, entityId, thresholdDays])
  @@index([createdAt])
  @@index([thresholdDays])
}

// =========================
// PLAN DE MANTENCIÓN POR HORÓMETRO
// =========================

model HorometerMaintenancePlan {
  id String @id @default(uuid())

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  enabled       Boolean @default(true)
  intervalHours Int     @default(500)

  nextDueHours Int

  lastNotifiedDueHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([nextDueHours])
}

// =========================
// INCIDENTES DE VEHÍCULOS
// =========================

model VehicleIncident {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User @relation("VehicleIncidentReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)

  empresa Empresa

  type     VehicleIncidentType
  severity VehicleIncidentSeverity @default(MEDIA)
  status   VehicleIncidentStatus   @default(ABIERTO)

  titulo      String?
  descripcion String

  ubicacionTexto String?
  lat           Decimal? @db.Decimal(10, 7)
  lng           Decimal? @db.Decimal(10, 7)

  kilometraje Int?
  horometro   Int?

  estadoOperativoReportado VehicleOperationalStatus?

  fotoUrl String?

  reportadoEn DateTime @default(now())
  cerradoEn   DateTime?

  workshopTasks WorkshopTask[]

  @@index([vehicleId])
  @@index([reportedById])
  @@index([empresa])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([reportadoEn])
  @@index([cerradoEn])
}

// =========================
// TAREAS DE TALLER
// =========================

model WorkshopTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidentId String?
  incident   VehicleIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  empresa Empresa

  createdById String
  createdBy   User @relation("WorkshopTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User? @relation("WorkshopTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User? @relation("WorkshopTaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  codigo String @unique

  titulo      String
  descripcion String?

  priority WorkshopTaskPriority @default(MEDIA)
  status   WorkshopTaskStatus   @default(PENDIENTE)

  diagnostico      String?
  trabajoRealizado String?
  observaciones    String?

  startedAt DateTime?
  closedAt  DateTime?

  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  assignments WorkshopTaskAssignment[]
  partsUsed   WorkshopTaskPart[]

  @@index([codigo])
  @@index([incidentId])
  @@index([vehicleId])
  @@index([empresa])
  @@index([createdById])
  @@index([assignedToId])
  @@index([closedById])
  @@index([priority])
  @@index([status])
  @@index([startedAt])
  @@index([closedAt])
}

// =========================
// ASIGNACIONES DE TALLER
// =========================

model WorkshopTaskAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workshopTaskId String
  workshopTask   WorkshopTask @relation(fields: [workshopTaskId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role WorkshopTaskAssignmentRole @default(APOYO)

  @@index([workshopTaskId])
  @@index([userId])
  @@index([role])
  @@unique([workshopTaskId, userId], name: "workshop_task_assignment_unique")
}

// =========================
// REPUESTOS USADOS EN TALLER
// =========================

model WorkshopTaskPart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workshopTaskId String
  workshopTask   WorkshopTask @relation(fields: [workshopTaskId], references: [id], onDelete: Cascade)

  nombre String

  cantidad      Int      @default(1)
  costoUnitario Decimal? @db.Decimal(12, 2)
  costoTotal    Decimal? @db.Decimal(12, 2)

  observacion String?

  @@index([workshopTaskId])
  @@index([nombre])
}

// =========================
// HORAS EXTRAS TALLER
// =========================

model WorkshopExtraHourReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  trabajadorId String
  trabajador   User @relation("WorkshopExtraHourTrabajador", fields: [trabajadorId], references: [id], onDelete: Cascade)

  trabajadorNombre   String
  trabajadorApellido String
  trabajadorRut      String?
  trabajadorEmail    String
  workerType         WorkerType

  fecha DateTime

  descripcionTrabajo String

  horaEntrada String
  horaSalida  String

  totalHoras Float

  estado WorkshopExtraHourStatus @default(ENVIADO)

  firmadoPorId String?
  firmadoPor   User? @relation("WorkshopExtraHourSignedBy", fields: [firmadoPorId], references: [id], onDelete: SetNull)

  firmadoAt DateTime?

  firmaDataUrl String? @db.Text

  observacionRechazo String?

  @@index([empresa])
  @@index([trabajadorId])
  @@index([workerType])
  @@index([fecha])
  @@index([estado])
  @@index([firmadoPorId])
}