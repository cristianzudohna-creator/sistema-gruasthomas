// ✅ Archivo: prisma/schema.prisma (PARTE 1/2)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  CONTROL_FLOTA
  ADMINISTRADORA
  TRABAJADOR
}

enum AuditEntity {
  USER
  VEHICLE
  DOCUMENT
  MAINTENANCE
  WORK_ORDER
  HOROMETER
  CLIENT

  VEHICLE_INCIDENT
  WORKSHOP_TASK
  VEHICLE_FAILURE_REPORT

  // ✅ NUEVO
  WORKSHOP_MAINTENANCE_TASK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TOGGLE
  LOGIN
  RESTORE
}

enum VehicleType {
  CAMION
  AUTO
  CAMIONETA
}

enum DocumentType {
  SOAP
  REVISION_TECNICA
  PERMISO_CIRCULACION
  SEGURO
  OTRO
}

enum MaintenanceType {
  CAMBIO_ACEITE
  CAMBIO_FILTROS
  FRENOS
  NEUMATICOS
  BATERIA
  ALINEACION_BALANCEO
  OTRO
}

enum Empresa {
  GRUAS_THOMAS
  INSPROTEL
}

enum VehicleOperationalStatus {
  OPERATIVO
  EN_PANA
  PARADO
}

enum WorkerType {
  CONDUCTOR
  RIGGER
  OPERADOR
  MECANICO
  JEFE_TALLER

  ADMINISTRACION
  ADQUISICIONES
  ASEO
  AYUDANTE_DE_MECANICO
  CASA_PARTICULAR
  LAVADOR_EQUIPOS
  MECANICO_HIDRAULICO
  NOCHERO
  PREVENCION
  SOLDADOR
  SUPERVISOR
  SUPERVISOR_TERRENO

  OTRO
}

// =========================
// ✅ INCIDENTES / TALLER
// =========================

enum VehicleIncidentType {
  PINCHAZO
  PANE_MECANICA
  FALLA_HIDRAULICA
  FALLA_ELECTRICA
  SOBRECALENTAMIENTO
  FUGA
  ACCIDENTE
  OTRO
}

enum VehicleIncidentSeverity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum VehicleIncidentStatus {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
  CANCELADO
}

enum WorkshopTaskStatus {
  PENDIENTE
  EN_REVISION
  EN_REPARACION
  ESPERANDO_REPUESTO
  EN_COMPRA
  COMPRADO
  ENTREGADO
  TERMINADA
  CANCELADA
}

enum WorkshopTaskPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum WorkshopTaskAssignmentRole {
  RESPONSABLE
  APOYO
}

enum WorkshopSupplyRequestStatus {
  PENDIENTE
  COMPRADO
  CANCELADO
}

// =========================
// ✅ HORAS EXTRAS TALLER
// =========================

enum WorkshopExtraHourStatus {
  BORRADOR
  ENVIADO
  FIRMADO
  RECHAZADO
}

// =========================
// ✅ REPORTE INGRESO VEHÍCULO CON FALLAS
// =========================

enum VehicleFailureReportStatus {
  PENDIENTE
  ASIGNADO
  EN_REVISION
  EN_REPARACION
  RESUELTO
  CANCELADO
}

// =========================
// ✅ NUEVO: MANTENIMIENTO TALLER
// =========================

enum WorkshopMaintenanceTaskStatus {
  PENDIENTE_ASIGNACION
  ASIGNADA
  EN_PROCESO
  ESPERANDO_FIRMA_TALLER
  ESPERANDO_FIRMA_CONTROL_FLOTA
  ESPERANDO_FIRMA_ADMINISTRADORA
  FINALIZADA
  RECHAZADA
  CANCELADA
}

enum WorkshopMaintenanceSignatureRole {
  TALLER
  CONTROL_FLOTA
  ADMINISTRADORA
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  nombre   String
  apellido String
  rut      String? @unique
  role     Role    @default(TRABAJADOR)
  activo   Boolean @default(true)

  mustChangePassword Boolean   @default(false)
  passwordResetAt    DateTime?

  empresa Empresa?

  workerType       WorkerType?
  workerTypesExtra WorkerType[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens   PasswordResetToken[]
  passwordResetRequests PasswordResetRequest[]
  auditLogs             AuditLog[]
  fcmTokens             UserFcmToken[]

  horometers HorometerRecord[] @relation("UserHorometers")

  workOrdersCreated   WorkOrder[] @relation("WorkOrderCreatedBy")
  workOrdersAssigned  WorkOrder[] @relation("WorkOrderAssignedTo")
  workOrdersCompleted WorkOrder[] @relation("WorkOrderCompletedBy")
  workOrdersApproved  WorkOrder[] @relation("WorkOrderApprovedBy")

  workOrderEvidences WorkOrderEvidence[]

  reportedIncidents       VehicleIncident[] @relation("VehicleIncidentReportedBy")
  workshopTasksCreated    WorkshopTask[] @relation("WorkshopTaskCreatedBy")
  workshopTasksAssigned   WorkshopTask[] @relation("WorkshopTaskAssignedTo")
  workshopTasksClosed     WorkshopTask[] @relation("WorkshopTaskClosedBy")
  workshopTaskAssignments WorkshopTaskAssignment[]

  supplyRequestsCreated WorkshopSupplyRequest[] @relation("WorkshopSupplyRequestedBy")
  supplyRequestsBought  WorkshopSupplyRequest[] @relation("WorkshopSupplyBoughtBy")

  extraHourReports       WorkshopExtraHourReport[] @relation("WorkshopExtraHourTrabajador")
  signedExtraHourReports WorkshopExtraHourReport[] @relation("WorkshopExtraHourSignedBy")

  vehicleFailureReportsCreated  VehicleFailureReport[] @relation("VehicleFailureReportCreatedBy")
  vehicleFailureReportsAssigned VehicleFailureReport[] @relation("VehicleFailureReportAssignedTo")
  vehicleFailureReportEvidences VehicleFailureReportEvidence[] @relation("VehicleFailureReportEvidenceUploadedBy")

  // ✅ NUEVO
  workshopMaintenanceTasksCreated  WorkshopMaintenanceTask[] @relation("WorkshopMaintenanceTaskCreatedBy")
  workshopMaintenanceTasksAssigned WorkshopMaintenanceTask[] @relation("WorkshopMaintenanceTaskAssignedTo")
  workshopMaintenanceSignatures    WorkshopMaintenanceSignature[] @relation("WorkshopMaintenanceSignatureSignedBy")

  @@index([empresa])
  @@index([workerType])
  @@index([workerTypesExtra])
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  userId    String
  rut       String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rut])
  @@index([code])
  @@index([expiresAt])
  @@index([createdAt])
}

model AuditLog {
  id       String      @id @default(uuid())
  entity   AuditEntity
  entityId String
  action   AuditAction

  actorId    String?
  actorEmail String?

  ip        String?
  userAgent String?

  data      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([actorEmail])
  @@index([createdAt])
  @@index([entity, createdAt])
  @@index([action, createdAt])
  @@index([entity, action, createdAt])
}

model Vehicle {
  id          String  @id @default(uuid())
  patente     String  @unique
  marcaModelo String
  conductor   String?

  type         VehicleType
  tipoVehiculo String?
  year         Int?

  empresa Empresa @default(GRUAS_THOMAS)

  estadoOperativo VehicleOperationalStatus @default(OPERATIVO)

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    VehicleDocument[]
  maintenances VehicleMaintenance[]

  horometers    HorometerRecord[]
  horometerPlan HorometerMaintenancePlan?
  workOrders    WorkOrder[]

  incidents      VehicleIncident[]
  workshopTasks  WorkshopTask[]
  failureReports VehicleFailureReport[]

  // ✅ NUEVO
  workshopMaintenanceTasks WorkshopMaintenanceTask[]

  @@index([empresa])
  @@index([estadoOperativo])
  @@index([activo])
}
// ✅ Archivo: prisma/schema.prisma (PARTE 2/2)

model VehicleDocument {
  id               String       @id @default(uuid())
  vehicleId        String
  type             DocumentType
  nombre           String?
  fechaVencimiento DateTime?
  observacion      String?
  archivoUrl       String?

  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@index([fechaVencimiento])
}

model VehicleMaintenance {
  id             String          @id @default(uuid())
  vehicleId      String
  type           MaintenanceType
  nombre         String?
  fechaRealizada DateTime
  fechaProxima   DateTime?
  observacion    String?
  archivoUrl     String?

  filePath     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@index([fechaProxima])
}

model HorometerRecord {
  id String @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  trabajadorId String
  trabajador   User @relation("UserHorometers", fields: [trabajadorId], references: [id], onDelete: Restrict)

  trabajadorNombre   String
  trabajadorApellido String
  trabajadorRut      String?
  trabajadorEmail    String

  empresa Empresa

  horas      Int
  comentario String?

  fotoUrl      String?
  filePath     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([trabajadorId])
  @@index([empresa])
  @@index([createdAt])
}

model CompanySettings {
  id      String  @id @default(uuid())
  empresa Empresa @unique

  nombre        String
  emailContacto String?
  telefono      String?
  direccion     String?
  logoUrl       String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  nombre String
  rut    String?

  giro      String?
  telefono  String?
  direccion String?
  comuna    String?
  ciudad    String?

  workOrders WorkOrder[]

  @@unique([empresa, rut], name: "client_empresa_rut_unique")
  @@index([empresa])
  @@index([nombre])
}

enum WorkOrderStatus {
  ABIERTA
  EN_PROCESO
  COMPLETADA
  APROBADA
  RECHAZADA
  CERRADA
}

enum WorkOrderPriority {
  BAJA
  MEDIA
  ALTA
}

enum WorkOrderType {
  MANTENCION
  REPARACION
  DOCUMENTO
  OTRO
}

model WorkOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa           @default(GRUAS_THOMAS)
  status   WorkOrderStatus   @default(ABIERTA)
  priority WorkOrderPriority @default(MEDIA)
  type     WorkOrderType     @default(OTRO)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  cliente               String?
  rut                   String?
  solicitadoPor         String?
  telefonoSolicitadoPor String?
  direccion             String?
  comuna                String?
  ciudad                String?

  telefonoCliente String?
  direccionFaena  String?

  lugar    String?
  horario  String?
  mapsLink String?

  camion    String?
  conductor String?
  operador  String?
  rigger    String?

  sinJib Boolean @default(false)

  diasTrabajo     String[] @default([])
  diasProgramados String[] @default([])

  nota String?

  titulo      String?
  descripcion String?

  fechaProgramada DateTime?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User? @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  startedAt       DateTime?
  finishedAt      DateTime?
  horasTrabajo    Int?
  comentarioFinal String?

  workerReport Json?

  completedAt   DateTime?
  completedById String?
  completedBy   User? @relation("WorkOrderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User? @relation("WorkOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalComment String?
  rejectReason    String?

  items     WorkOrderItem[]
  evidences WorkOrderEvidence[]

  activo    Boolean   @default(true)
  deletedAt DateTime?

  @@index([empresa])
  @@index([status])
  @@index([assignedToId])
  @@index([vehicleId])
  @@index([completedAt])
  @@index([completedById])
  @@index([approvedAt])
  @@index([approvedById])
  @@index([clientId])
  @@index([activo])
  @@index([empresa, activo])
  @@index([deletedAt])
}

model WorkOrderItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  titulo      String
  obligatorio Boolean @default(false)

  done   Boolean   @default(false)
  doneAt DateTime?

  @@index([workOrderId])
}

model WorkOrderEvidence {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  fileUrl      String
  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  @@index([workOrderId])
  @@index([uploadedById])
}

enum AlertKind {
  DOCUMENT
  MAINTENANCE
  HOROMETER
}

model AlertDispatchLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  kind          AlertKind
  entityId      String
  thresholdDays Int

  recipient String?
  subject   String?
  messageId String?

  @@unique([kind, entityId, thresholdDays])
  @@index([createdAt])
  @@index([thresholdDays])
}

model HorometerMaintenancePlan {
  id String @id @default(uuid())

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  enabled       Boolean @default(true)
  intervalHours Int     @default(500)

  nextDueHours Int

  lastNotifiedDueHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([nextDueHours])
}

model VehicleIncident {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User @relation("VehicleIncidentReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)

  empresa Empresa

  type     VehicleIncidentType
  severity VehicleIncidentSeverity @default(MEDIA)
  status   VehicleIncidentStatus   @default(ABIERTO)

  titulo      String?
  descripcion String

  ubicacionTexto String?
  lat           Decimal? @db.Decimal(10, 7)
  lng           Decimal? @db.Decimal(10, 7)

  kilometraje Int?
  horometro   Int?

  estadoOperativoReportado VehicleOperationalStatus?

  fotoUrl String?

  reportadoEn DateTime @default(now())
  cerradoEn   DateTime?

  workshopTasks WorkshopTask[]

  @@index([vehicleId])
  @@index([reportedById])
  @@index([empresa])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([reportadoEn])
  @@index([cerradoEn])
}

model WorkshopTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidentId String?
  incident   VehicleIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  empresa Empresa

  createdById String
  createdBy   User @relation("WorkshopTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User? @relation("WorkshopTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User? @relation("WorkshopTaskClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  codigo String @unique

  titulo      String
  descripcion String?

  priority WorkshopTaskPriority @default(MEDIA)
  status   WorkshopTaskStatus   @default(PENDIENTE)

  diagnostico      String?
  trabajoRealizado String?
  observaciones    String?

  problemaRepuesto String?

  startedAt DateTime?
  closedAt  DateTime?

  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  assignments WorkshopTaskAssignment[]
  partsUsed   WorkshopTaskPart[]

  @@index([codigo])
  @@index([incidentId])
  @@index([vehicleId])
  @@index([empresa])
  @@index([createdById])
  @@index([assignedToId])
  @@index([closedById])
  @@index([priority])
  @@index([status])
  @@index([startedAt])
  @@index([closedAt])
}

model WorkshopTaskAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workshopTaskId String
  workshopTask   WorkshopTask @relation(fields: [workshopTaskId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role WorkshopTaskAssignmentRole @default(APOYO)

  @@index([workshopTaskId])
  @@index([userId])
  @@index([role])

  @@unique([workshopTaskId, userId], name: "workshop_task_assignment_unique")
}

model WorkshopTaskPart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  workshopTaskId String
  workshopTask   WorkshopTask @relation(fields: [workshopTaskId], references: [id], onDelete: Cascade)

  nombre String

  cantidad      Int      @default(1)
  costoUnitario Decimal? @db.Decimal(12, 2)
  costoTotal    Decimal? @db.Decimal(12, 2)

  observacion String?

  @@index([workshopTaskId])
  @@index([nombre])
}
model WorkshopSupplyRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  nombre      String
  observacion String?

  fotoUrl      String?
  filePath     String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  estado WorkshopSupplyRequestStatus @default(PENDIENTE)

  solicitadoPorId String
  solicitadoPor   User @relation("WorkshopSupplyRequestedBy", fields: [solicitadoPorId], references: [id], onDelete: Restrict)

  compradoPorId String?
  compradoPor   User? @relation("WorkshopSupplyBoughtBy", fields: [compradoPorId], references: [id], onDelete: SetNull)

  solicitadoAt DateTime @default(now())
  compradoAt   DateTime?

  @@index([empresa])
  @@index([estado])
  @@index([solicitadoPorId])
  @@index([compradoPorId])
  @@index([solicitadoAt])
  @@index([compradoAt])
  @@index([nombre])
}

model WorkshopExtraHourReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  trabajadorId String
  trabajador   User @relation("WorkshopExtraHourTrabajador", fields: [trabajadorId], references: [id], onDelete: Cascade)

  trabajadorNombre   String
  trabajadorApellido String
  trabajadorRut      String?
  trabajadorEmail    String
  workerType         WorkerType

  fecha DateTime

  descripcionTrabajo String

  horaEntrada String
  horaSalida  String

  totalHoras Float

  estado WorkshopExtraHourStatus @default(ENVIADO)

  firmadoPorId String?
  firmadoPor   User? @relation("WorkshopExtraHourSignedBy", fields: [firmadoPorId], references: [id], onDelete: SetNull)

  firmadoAt DateTime?

  firmaDataUrl String? @db.Text

  observacionRechazo String?

  @@index([empresa])
  @@index([trabajadorId])
  @@index([workerType])
  @@index([fecha])
  @@index([estado])
  @@index([firmadoPorId])
}

model VehicleFailureReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  patente String

  traidoPorNombre String

  descripcion String

  status VehicleFailureReportStatus @default(PENDIENTE)

  createdById String
  createdBy   User @relation("VehicleFailureReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User? @relation("VehicleFailureReportAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignedAt DateTime?
  resolvedAt DateTime?

  evidences VehicleFailureReportEvidence[]

  @@index([empresa])
  @@index([vehicleId])
  @@index([patente])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([assignedAt])
  @@index([resolvedAt])
}

model VehicleFailureReportEvidence {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  reportId String
  report   VehicleFailureReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User @relation("VehicleFailureReportEvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  fileUrl      String
  filePath     String
  originalName String
  mimeType     String
  sizeBytes    Int

  @@index([reportId])
  @@index([uploadedById])
  @@index([createdAt])
}

// =========================
// ✅ NUEVO: TAREAS DE MANTENIMIENTO TALLER CON FIRMAS
// =========================

model WorkshopMaintenanceTask {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa

  codigo String @unique

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  patenteSnapshot String

  createdById String
  createdBy   User @relation("WorkshopMaintenanceTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User? @relation("WorkshopMaintenanceTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  assignedAt DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  status WorkshopMaintenanceTaskStatus @default(PENDIENTE_ASIGNACION)

  titulo      String
  descripcion String?

  kilometraje Int?
  horas       Int?
  fecha       DateTime?

  trabajosRealizados   String[] @default([])
  repuestosLubricantes String[] @default([])
  codigosFiltros       String[] @default([])

  observaciones String?

  rechazoMotivo String?

  signatures WorkshopMaintenanceSignature[]

  @@index([empresa])
  @@index([codigo])
  @@index([vehicleId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedAt])
  @@index([finishedAt])
}

model WorkshopMaintenanceSignature {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  taskId String
  task   WorkshopMaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  role WorkshopMaintenanceSignatureRole

  signedById String
  signedBy   User @relation("WorkshopMaintenanceSignatureSignedBy", fields: [signedById], references: [id], onDelete: Restrict)

  signedAt DateTime @default(now())

  firmaDataUrl String @db.Text

  nombreFirmante String?
  rutFirmante    String?
  cargoFirmante  String?

  @@index([taskId])
  @@index([role])
  @@index([signedById])
  @@index([signedAt])

  @@unique([taskId, role], name: "workshop_maintenance_signature_unique")
}